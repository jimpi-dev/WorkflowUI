# Optional: copy to .env and adjust. The backend reads .env from the WorkflowUI root.

# ComfyUI API URL (default: http://localhost:8188/)
# COMFYUI_URL=http://localhost:8188/

# Media storage (optional)
# MEDIA_STORAGE_ENABLED=false
# MEDIA_STORAGE_ROOT_PATH=media_storage
# MEDIA_STORAGE_DELETE_REMOTE=false

# Input data directory for uploaded media (default: input_data)
# INPUT_DATA_DIR=input_data

# WorkflowUI metadata in images (for restore-from-image on Import page)
# WORKFLOWUI_EMBED_METADATA_ON_DOWNLOAD=true   # Append metadata when user downloads/saves image from UI
# WORKFLOWUI_EMBED_METADATA_ON_SAVE=true      # Append metadata when saving run to local storage

# GenVault integration (optional)
# GENVAULT_ENABLED=true
# GENVAULT_URL=http://localhost:8090

# CORS configuration for the backend (optional).
# Comma-separated list of allowed origins for the frontend.
# If not set, defaults to http://localhost:5173 and http://127.0.0.1:5173
# WORKFLOWUI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional authentication and user management
# WORKFLOWUI_AUTH_ENABLED=false
# WORKFLOWUI_AUTH_SECRET=change-me
# WORKFLOWUI_AUTH_TOKEN_TTL_SECONDS=86400
# WORKFLOWUI_AUTH_ADMIN_USERNAME=admin
# WORKFLOWUI_AUTH_ADMIN_PASSWORD=admin
