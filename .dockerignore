# Reduce build context and avoid copying dev/runtime junk
frontend/node_modules
frontend/.svelte-kit
frontend/build
frontend/coverage
backend/__pycache__
backend/.pytest_cache
backend/media_storage
*.pyc
.git
.gitignore
*.md
# Allow blog markdown so /home page works in Docker
!frontend/src/blog/
!frontend/src/blog/*.md
.env
.env.*
