# Copy to .env and adjust. Used by docker-compose and as reference for `docker run -e`.

# Port the app listens on inside the container (map with -p HOST:CONTAINER).
PORT=3000

# Optional: SQLite DB file path. When unset, the app uses its default path.
# Set for persistence with a volume, e.g. /data/workflow.db
# WORKFLOWUI_DB_PATH=/data/workflow.db

# ComfyUI base URL (use host.docker.internal on Docker Desktop to reach host).
COMFYUI_URL=http://localhost:8188/

# Directory for uploaded input media (images, etc.). Can be a path to its own volume mount (e.g. /inputs).
INPUT_DATA_DIR=input_data

# Local media storage (saved run outputs). Can be a path to its own volume mount (e.g. /media).
MEDIA_STORAGE_ENABLED=false
MEDIA_STORAGE_ROOT_PATH=media_storage
MEDIA_STORAGE_DELETE_REMOTE=false

# --- Optional: one shared volume at /data ---
# WORKFLOWUI_DB_PATH=/data/workflow.db
# INPUT_DATA_DIR=/data/input_data
# MEDIA_STORAGE_ENABLED=true
# MEDIA_STORAGE_ROOT_PATH=/data/media_storage

# --- Optional: separate mounts (e.g. workflowui-media:/media, workflowui-inputs:/inputs) ---
# MEDIA_STORAGE_ROOT_PATH=/media
# INPUT_DATA_DIR=/inputs
